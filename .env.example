# Supabase (project flqitkskfxqsuipukyzc)
SUPABASE_URL=https://flqitkskfxqsuipukyzc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# YouTube Data API v3
YOUTUBE_API_KEY=

# Optional: browser-exported cookies JSON for transcript fetch (see ingest/youtube_cookies.json)
# YOUTUBE_COOKIES_PATH=ingest/youtube_cookies.json

# Optional: residential proxy for transcript fetch from cloud IPs (GitHub Actions)
# YOUTUBE_PROXY_URL=http://user:pass@host:port

# OpenAI
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
# Each source video is split/re-encoded before transcription to stay under API file limits.
# Requires ffmpeg/ffprobe on PATH.
# TRANSCRIPTION_AUDIO_CHUNK_SECONDS=600
# TRANSCRIPTION_AUDIO_BITRATE=48k

# Pinecone (standard dense index for copied OpenAI embeddings)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=tbpn-transcript-chunks
PINECONE_NAMESPACE=production
# Optional: set after index creation to avoid name-to-host resolution at runtime
# PINECONE_INDEX_HOST=

# Guest catalog (same source as tbpn-guests-research / tbpnguests.vercel.app)
# Local dev: point at sibling repo checkout
# GUEST_DATA_DIR=../tbpn-guests-research
# Vercel/production: fetch from GitHub (set GITHUB_SYNC_TOKEN if repo is private)
# GUEST_GITHUB_REPOSITORY=BenMacklinn/tbpn-guests-research
# GUEST_GITHUB_BRANCH=main
# GUEST_CATALOG_API_URL=https://tbpnguests.vercel.app/api/catalog

# Next.js (copy to web/.env.local or use root .env)
NEXT_PUBLIC_SUPABASE_URL=https://flqitkskfxqsuipukyzc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
